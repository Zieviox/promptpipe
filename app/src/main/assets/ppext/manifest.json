{
  "manifest_version": 2,
  "name": "promptpipe bridge",
  "version": "1.0",
  "description": "Lets the promptpipe app type into the AI chat page and read its replies.",
  "browser_specific_settings": {
    "gecko": {
      "id": "promptpipe@zieviox.dev"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
